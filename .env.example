# ── BetterPvP Admin Console ──────────────────────────────────────────────
# This console connects directly to the BetterPvP game's PostgreSQL database.
# In production this is the same Postgres the game server reads content from.
# For local development, point it at a throwaway Postgres with db/sql applied.

# PostgreSQL connection string (the game database).
DATABASE_URL="postgres://postgres:postgres@localhost:5432/betterpvp"

# Auth.js (NextAuth v5). Generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-long-random-string"

# Base URL of this app. Required by Auth.js in production.
AUTH_URL="http://localhost:3000"

# Cosmetic environment banner: development | staging | production
NEXT_PUBLIC_APP_ENV="development"
